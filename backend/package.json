{
  "name": "before-i-buy-backend-tooling",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "supabase": "2.114.0"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:migrate": "supabase migration up --local",
    "db:test": "supabase test db",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop --no-backup",
    "test:edge-contract": "node --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-include=\"supabase/functions/guest-invite/handler.mjs\" --test tests/guest-invite-handler.test.mjs",
    "test:db-concurrency": "node --test tests/guest-session-concurrency.test.mjs",
    "test:expiration-runtime": "node --test tests/automatic-dilemma-expiration.test.mjs",
    "test:edge-runtime": "bash scripts/test_guest_invite_runtime.sh"
  }
}
